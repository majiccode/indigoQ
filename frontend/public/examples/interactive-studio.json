      { "id": "studio-html", "name": "HTML Spring", "type": "playground", "x": 550, "y": 700, "width": 450, "height": 600, "contents": [], "tool": { "kind": "playground", "settings": {}, "text": "<style>body{background:#15202b;color:#eee;font:18px system-ui}#ball{width:50px;height:50px;border-radius:50%;background:#c8a4ff;margin:60px}</style><h2>Connected mini-app</h2><div id='ball'></div><p id='label'>Move the shared knobs</p><script>let p={amplitude:2,frequency:1.5,color:'#c8a4ff'};addEventListener('indigoq:input',e=>{p={...p,...e.detail.controls};document.querySelector('#label').textContent=JSON.stringify(p)});function frame(t){let b=document.querySelector('#ball');b.style.transform='translateX('+(Math.sin(t/1000*p.frequency)*p.amplitude*30)+'px)';b.style.background=p.color;requestAnimationFrame(frame)}requestAnimationFrame(frame)</script>", "output": "" } },
